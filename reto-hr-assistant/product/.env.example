# Copia este archivo a .env y completa solo lo que necesites. Nunca subas .env.

# Producto
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000

# Acceso y compliance
# ENVIRONMENT: development o production (production aplica las reglas de compliance).
ENVIRONMENT=development
# API_KEYS: cliente:clave,cliente2:clave2 (secreto). Vacía, toda pregunta da 401.
# Genera cada clave con: python -c "import secrets; print(secrets.token_urlsafe(24))"
# En producción cada clave necesita 16 caracteres o más.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Protección de datos personales
# PII_REDACTION: oculta correos, teléfonos, CURP, RFC y tarjetas en preguntas y
# respuestas. En production debe valer true o el producto no arranca.
PII_REDACTION=true
# MAX_ANSWER_CHARS: largo máximo de la respuesta que llega al cliente.
MAX_ANSWER_CHARS=1500

# Trazas en LangSmith (opcional; la clave es secreta)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare AI Gateway (obligatorias con MODEL_PROVIDER=gateway; el token es secreto)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
