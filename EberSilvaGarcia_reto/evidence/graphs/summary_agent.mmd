---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	gather_facts(gather_facts)
	draft(draft)
	critique(critique)
	revise(revise)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> gather_facts;
	critique -.-> finalize;
	critique -.-> revise;
	draft --> critique;
	gather_facts --> draft;
	revise --> critique;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
