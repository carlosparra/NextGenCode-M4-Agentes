---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	reason(reason)
	act(act)
	give_up(give_up)
	__end__([<p>__end__</p>]):::last
	__start__ --> reason;
	act -. &nbsp;end&nbsp; .-> __end__;
	act -.-> reason;
	reason -. &nbsp;end&nbsp; .-> __end__;
	reason -.-> act;
	reason -.-> give_up;
	give_up --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
