# Copia este archivo a .env y llena los secretos. .env nunca se sube a git.

# --- Entorno y servicio
# production activa el compliance al arrancar
ENVIRONMENT=development
SERVICE_NAME=hr-assistant

# --- Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI)
MODEL_PROVIDER=fake
CF_ACCOUNT_ID=
CF_GATEWAY_ID=hr-assistant
# secreto: permisos Workers AI (Read/Edit) y AI Gateway (Run)
CF_API_TOKEN=
# el gateway es autenticado (cf-aig-authorization)
CF_GATEWAY_AUTH=true
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
MODEL_TIMEOUT_SECONDS=30
MODEL_RETRIES=2

# --- Agentes
# tope del supervisor
AGENT_MAX_STEPS=4
# tope del agente de vacaciones (ReAct)
SUBAGENT_MAX_STEPS=6
# vueltas máximas del agente de resumen
REFLECTION_MAX_ROUNDS=2
MAX_QUESTION_CHARS=2000

# --- Palancas de costo
# modelo barato salvo preguntas complejas
ROUTING=true
ROUTER_MAX_CHARS=80
# mensajes de historial que se mandan al modelo
HISTORY_WINDOW=6
# tope de salida
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
# caché de AI Gateway (0 la apaga)
CACHE_TTL_SECONDS=3600
# caché de respuestas en memoria (0 la apaga)
ANSWER_CACHE_TTL_SECONDS=300
# prompts y observaciones compactos
COMPACT_PROMPTS=true

# --- Seguridad
# secreto: cliente:clave,cliente2:clave2 (16+ caracteres en producción)
API_KEYS=
# opcional: cliente:ask|mcp|metrics (por omisión, todos)
CLIENT_SCOPES=
RATE_LIMIT_PER_MINUTE=30
# mask enmascara la PII de las preguntas; block las rechaza
PII_POLICY=mask
# opcional: archivo JSONL solo con la auditoría
AUDIT_LOG_PATH=

# --- Observabilidad
SLO_P95_MS=2000
LANGSMITH_TRACING=false
# secreto
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hr-assistant
# en producción deben ser true
HIDE_INPUTS=true
HIDE_OUTPUTS=true
