# Copia este archivo a .env (chmod 600) y llena los valores. Nunca subas .env a git.

# --- Entorno ---
ENVIRONMENT=development          # production aplica las reglas de compliance
SERVICE_NAME=hr-assistant
MODEL_PROVIDER=fake              # fake (sin red ni costo) o gateway (Cloudflare)

# --- Agentes ---
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
MAX_HISTORY_MESSAGES=50
MAX_ANSWER_CHARS=4000

# --- Acceso (secreto: cliente:clave, claves de 16 caracteres o más) ---
API_KEYS=
# Permisos por cliente: ask, mcp, metrics. Varios con +. Obligatorio en producción.
CLIENT_SCOPES=portal:ask,claude:mcp,grafana:metrics
RATE_LIMIT_PER_MINUTE=30
# Hosts públicos permitidos para el MCP remoto (Render agrega el suyo solo)
MCP_ALLOWED_HOSTS=

# --- Cloudflare Workers AI a través de AI Gateway ---
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=                    # secreto
CF_AIG_TOKEN=                    # secreto; solo si el gateway es autenticado
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30

# --- Palancas de costo ---
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
COMPACT_PROMPT=true
CACHE_TTL_SECONDS=0              # caché de AI Gateway (0: apagada)
RESPONSE_CACHE_TTL_SECONDS=0     # caché de respuestas del servicio (0: apagada)

# --- Observabilidad ---
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=               # secreto
LANGSMITH_PROJECT=hr-assistant
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # solo si tu cuenta es EU
HIDE_INPUTS=true
HIDE_OUTPUTS=true
