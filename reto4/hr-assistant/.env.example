# Configuración del HR Assistant. Copia este archivo a .env, llena lo que falte y
# arranca con: uvicorn app.main:app --env-file .env --port 8000
# Nunca subas .env al repositorio: API_KEYS, CF_API_TOKEN y LANGSMITH_API_KEY son
# secretos.

# --- Sesión 1: producto base ---
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# --- Sesión 2: observabilidad ---
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000

# --- Sesión 2: trazas en LangSmith (opcionales; sin clave no se conecta) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# --- Sesión 3: modelo real (solo con MODEL_PROVIDER=gateway) ---
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# --- Sesión 3: palancas de costo ---
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# --- Sesión 4: producción ---
# Con ENVIRONMENT=production el producto no arranca si MODEL_PROVIDER=fake, si
# API_KEYS está vacía o tiene una clave de menos de 16 caracteres, o si hay
# trazas sin HIDE_INPUTS=true y HIDE_OUTPUTS=true.
ENVIRONMENT=development
# Forma: cliente:clave,cliente2:clave2. Sin claves, /ask y /metrics dan 401.
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
