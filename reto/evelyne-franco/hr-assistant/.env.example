# Variables del HR Assistant. Copia este archivo a .env y llena solo lo que uses.
# Nunca subas .env al repositorio: el token de Cloudflare y API_KEYS son secretos.

# -- Sesion 1: producto ---------------------------------------------
# fake (simulado, sin red ni costo) o gateway (Cloudflare AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# -- Sesion 2: observabilidad ---------------------------------------
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# -- Sesion 3: modelo real y costos ---------------------------------
# Obligatorias con MODEL_PROVIDER=gateway.
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# -- Sesion 4: produccion -------------------------------------------
# development o production. Con production el producto no arranca si
# MODEL_PROVIDER=fake, si API_KEYS esta vacia o tiene claves de menos de
# 16 caracteres, o si las trazas estan encendidas sin HIDE_INPUTS y
# HIDE_OUTPUTS en true.
ENVIRONMENT=development
# Secreto. Forma: cliente:clave,cliente2:clave2. Sin claves, /ask y
# /metrics responden 401. Genera cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Peticiones por cliente por minuto (mayor que 0).
RATE_LIMIT_PER_MINUTE=30

# -- Reto: seguridad reforzada --------------------------------------
# Largo maximo de la respuesta (mayor que 0). Despues de ocultar PII y
# secretos, una respuesta mas larga se recorta y se audita.
MAX_ANSWER_CHARS=2000
