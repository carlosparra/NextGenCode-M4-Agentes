# HR Assistant: todas las variables. Copia a .env y rellena; nunca subas el .env.
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000

# Acceso (sesion 4). API_KEYS es secreto: cliente:clave,cliente2:clave2
# Con ENVIRONMENT=production cada clave debe tener 16 caracteres o mas.
ENVIRONMENT=development
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# PII (sesion 5): enmascara CURP y correo. En production no puede ser false.
PII_MASKING=true

# LangSmith (opcional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare AI Gateway (solo con MODEL_PROVIDER=gateway). El token es secreto.
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
