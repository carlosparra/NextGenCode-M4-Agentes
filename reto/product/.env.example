# Variables del HR Assistant. Copia este archivo a .env y completa lo que falte.
# Nunca subas .env al repositorio: API_KEYS, CF_API_TOKEN, CF_AIG_TOKEN y
# LANGSMITH_API_KEY son secretos.

# Modelo: fake (simulado, sin red ni costo real) o gateway (Cloudflare AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad (sesion 2)
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=
# Opcional y secreto: token del AI Gateway cuando tiene "Authenticated Gateway"
# encendido (se manda en cf-aig-authorization). Vacio: no se manda.
CF_AIG_TOKEN=

# Palancas de costo (sesion 3)
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Produccion (sesion 4)
# development o production; con production el producto no arranca si la
# configuracion no es segura (ver doc/compliance-checklist.md)
ENVIRONMENT=development
# Clientes y claves: cliente:clave,cliente2:clave2 (en produccion, 16+ caracteres)
API_KEYS=
RATE_LIMIT_PER_MINUTE=30

# Produccion operable (reto)
# Version en /health y en OpenAPI
APP_VERSION=1.0.0
# Procesos de uvicorn en el contenedor (metricas, limite y cache son por proceso)
WEB_CONCURRENCY=1
# Cache de respuestas en memoria (palanca 5): segundos de vida (0: apagada) y
# entradas maximas. Una pregunta repetida se responde sin llamar al modelo; nunca
# se guardan respuestas con datos sensibles ni salidas bloqueadas.
RESPONSE_CACHE_TTL_SECONDS=0
RESPONSE_CACHE_SIZE=256
# Datos sensibles (correo, telefono, CURP, RFC, tarjeta, NSS) en la pregunta o el
# historial: mask (se reemplazan por [EMAIL], [TELEFONO]... antes del modelo, el
# log y la traza) o block (400 sensitive data not allowed)
PII_POLICY=mask
# Largo maximo de la respuesta; se recorta antes de devolverla
MAX_ANSWER_CHARS=2000
